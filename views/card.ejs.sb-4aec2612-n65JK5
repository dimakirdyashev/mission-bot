<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Секретная миссия</title>

  <style>
    body{margin:0;font-family:system-ui,Arial;background:radial-gradient(circle at top,#063a2b,#02140f 70%);color:#caffde;}
    .container{max-width:820px;margin:40px auto;padding:20px;}
    .chips{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
    .chip{border:1px solid #1aff9c;color:#86ffc8;padding:6px 14px;border-radius:999px;font-size:13px;letter-spacing:1px}
    .card{background:#031d16;border-radius:18px;padding:26px;border:1px solid #0c4a37;box-shadow:0 0 30px rgba(0,255,170,.15);}
    h1{margin:0 0 8px;font-size:34px;color:#a4ffd4;letter-spacing:1px}
    .sub{opacity:.9;margin:0 0 18px}
    .box{margin-top:16px;background:#02140f;border:1px solid #0c4a37;border-radius:16px;padding:18px;line-height:1.55}
    .row{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px;align-items:center}
    .btn{appearance:none;border:none;cursor:pointer;padding:14px 22px;border-radius:12px;font-weight:800;letter-spacing:1px}
    .btn-yes{background:#00ff9c;color:#01251b}
    .btn-back{background:#0b2f25;color:#a4ffd4;border:1px solid #0c4a37}
    .arena{position:relative;height:78px;margin-top:16px;border:1px dashed rgba(255,255,255,.15);border-radius:14px}
    .btn-no{
      position:absolute; left:220px; top:16px;
      background:#2a0000; color:#ff8a8a;
      border:1px solid rgba(255,0,0,.25);
    }
    .log{margin-top:14px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14px;line-height:1.45}
    .log .bad{color:#ff6b6b}
    .log .ok{color:#86ffc8}
    .hidden{display:none}
  </style>
</head>

<body>
  <div class="container">

    <div class="chips">
      <span class="chip">23 ФЕВРАЛЯ</span>
      <span class="chip">СЕКРЕТНАЯ МИССИЯ</span>
      <span class="chip" id="chipScreen">ЭКРАН: ВВОДНАЯ</span>
    </div>

    <div class="card">
      <!-- ====== SCREEN 1: INTRO ====== -->
      <section id="screenIntro">
        <h1>БОЕЦ! ПОСТУПИЛА ВВОДНАЯ</h1>
        <p class="sub">
          Объект: <b><%= card.toName %></b> • Уровень допуска: <b>СОВЕРШЕННО СЕКРЕТНО</b><br/>
          Отказ расценивается как дезертирство. Выбирай аккуратно 😄
        </p>

        <div class="box">
          <b>ПРОТОКОЛ 23-ФЕВ</b><br/><br/>
          Операция: <b><%= (card.giftName && card.giftName.trim()) ? card.giftName : "Секретная миссия" %></b><br/>
          Цель: улыбка бойца + 1 обнимашка<br/>
          Условие: нажать <b>“ТАК ТОЧНО!”</b>
        </div>

        <div class="row">
          <button class="btn btn-yes" id="btnYes">ТАК ТОЧНО!</button>
        </div>

        <div class="arena" id="arena">
          <button class="btn btn-no" id="btnNo" type="button">НИКАК НЕТ</button>
        </div>

        <div class="log" id="log"></div>
      </section>

      <!-- ====== SCREEN 2: MESSAGE ====== -->
      <section id="screenMsg" class="hidden">
        <h1>ПОЗДРАВЛЕНИЕ ПРИНЯТО. ШТАБ ОДОБРЯЕТ ✅</h1>
        <p class="sub">
          Боец <b><%= card.toName %></b>, поздравляю с 23 февраля!<br/>
          Ниже — секретное сообщение 😎
        </p>

        <div class="box">
          <%= (card.message || "").replace(/\n/g, "<br/>") %><br/><br/>
          <b>— <%= card.fromName || "" %></b>
        </div>

        <% if ((card.giftName && card.giftName.trim()) || (card.giftWhere && card.giftWhere.trim())) { %>
          <div class="box" style="margin-top:14px">
            <% if (card.giftName && card.giftName.trim()) { %>
              <b>НАГРАДА:</b> <%= card.giftName %><br/>
            <% } %>
            <% if (card.giftWhere && card.giftWhere.trim()) { %>
              <b>ГДЕ НАЙТИ:</b> <%= card.giftWhere %>
            <% } %>
          </div>
        <% } %>

        <div class="row">
          <button class="btn btn-back" id="btnBack">ВЕРНУТЬСЯ К ВВОДНОЙ</button>
        </div>
      </section>
    </div>
  </div>

<script>
  const chipScreen = document.getElementById("chipScreen");
  const intro = document.getElementById("screenIntro");
  const msg = document.getElementById("screenMsg");
  const btnYes = document.getElementById("btnYes");
  const btnBack = document.getElementById("btnBack");
  const btnNo = document.getElementById("btnNo");
  const arena = document.getElementById("arena");
  const log = document.getElementById("log");

  function setScreen(name){
    if(name === "msg"){
      intro.classList.add("hidden");
      msg.classList.remove("hidden");
      chipScreen.textContent = "ЭКРАН: ПОЗДРАВЛЕНИЕ";
    } else {
      msg.classList.add("hidden");
      intro.classList.remove("hidden");
      chipScreen.textContent = "ЭКРАН: ВВОДНАЯ";
    }
  }

  // "Так точно" — переходим на поздравление
  btnYes.addEventListener("click", () => setScreen("msg"));
  btnBack.addEventListener("click", () => setScreen("intro"));

  // "Никак нет" — убегает
  function moveNo(){
    const a = arena.getBoundingClientRect();
    const b = btnNo.getBoundingClientRect();

    const maxX = Math.max(10, a.width - b.width - 10);
    const maxY = Math.max(10, a.height - b.height - 10);

    const x = Math.floor(Math.random() * maxX);
    const y = Math.floor(Math.random() * maxY);

    btnNo.style.left = x + "px";
    btnNo.style.top = y + "px";

    const t = new Date();
    const hh = String(t.getHours()).padStart(2,"0");
    const mm = String(t.getMinutes()).padStart(2,"0");
    const ss = String(t.getSeconds()).padStart(2,"0");

    log.innerHTML =
      `<div class="bad">[${hh}:${mm}:${ss}] Ошибка доступа! 🚫 “НИКАК НЕТ” временно заблокирована.</div>` +
      `<div class="ok">[${hh}:${mm}:${ss}] Штаб: отказ не принят. Рекомендуем “ТАК ТОЧНО!”</div>` +
      log.innerHTML;
  }

  // Для компа
  btnNo.addEventListener("mouseenter", moveNo);
  btnNo.addEventListener("mousemove", moveNo);

  // Для телефона
  btnNo.addEventListener("touchstart", (e) => { e.preventDefault(); moveNo(); }, {passive:false});
  btnNo.addEventListener("click", (e) => { e.preventDefault(); moveNo(); });
</script>

</body>
</html>

