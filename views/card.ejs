<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Секретная миссия</title>

<style>
.actions{
  display:flex;
  gap:18px;
  margin-top:20px;
}

.btn{
  padding:16px 28px;
  border-radius:14px;
  font-weight:700;
  letter-spacing:1px;
  border:2px solid #1aff9c;
  background:transparent;
  color:#1aff9c;
  cursor:pointer;
  transition:.25s;
}

.btn.yes:hover{
  background:#1aff9c;
  color:#001b12;
  box-shadow:0 0 20px #1aff9c66;
}

.btn.no{
  border-color:#ff4d4d;
  color:#ff4d4d;
}

.btn.no:hover{
  transform:translateX(40px);
  box-shadow:0 0 20px #ff4d4d55;
}

.log{
  margin-top:25px;
  border:1px solid rgba(0,255,170,.25);
  border-radius:14px;
  padding:16px;
  font-family:monospace;
  line-height:1.6;
  background:rgba(0,0,0,.45);
}

body{
  margin:0;
  font-family: system-ui, Arial;
  background: radial-gradient(circle at top,#063a2b,#02140f 70%);
  color:#caffde;
}

.container{
  max-width:820px;
  margin:30px auto;
  padding:20px;
}

.header{
  margin-bottom:20px;
}

.chips{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:18px;
}

.chip{
  padding:8px 14px;
  border:1px solid rgba(202,255,222,.25);
  border-radius:999px;
  font-size:14px;
  background:rgba(0,0,0,.25);
}

.card{
  background:rgba(0,0,0,.35);
  border:1px solid rgba(202,255,222,.15);
  border-radius:18px;
  padding:22px;
}

h1{
  margin-top:0;
}

.sub{
  opacity:.85;
  line-height:1.5;
}

.box{
  margin-top:18px;
  padding:16px;
  border-radius:14px;
  border:1px solid rgba(202,255,222,.18);
  background:rgba(255,255,255,.03);
}

.buttons{
  margin-top:25px;
  display:flex;
  gap:15px;
}

button{
  padding:14px 22px;
  border-radius:12px;
  font-size:16px;
  border:none;
  cursor:pointer;
}

.yes{
  background:#1f8f55;
  color:white;
}

.no{
  background:#402222;
  color:#ffbdbd;
  position:relative;
}

.hidden{
  display:none;
}

.log{
  margin-top:20px;
  font-family:monospace;
  line-height:1.5;
  color:#9effc8;
}
</style>
</head>

<body>

<div class="container">

  <div class="chips">
    <span class="chip">23 ФЕВРАЛЯ</span>
    <span class="chip">СЕКРЕТНАЯ МИССИЯ</span>
    <span class="chip" id="chipScreen">ЭКРАН: ВВОДНАЯ</span>
  </div>

  <div class="card">

    <!-- ===== SCREEN 1 ===== -->
    <!-- ====== SCREEN 1: INTRO ====== -->
<section id="screenIntro">

  <h1>БОЕЦ! ПОСТУПИЛА ВВОДНАЯ: ПРИНЯТЬ ПОЗДРАВЛЕНИЯ.</h1>

  <p class="sub">
    Объект: <b><%= d.to || "БОЕЦ" %></b> • Уровень допуска: <b>СОВЕРШЕННО СЕКРЕТНО</b><br/>
    Отказ расценивается как дезертирство. Выбирай аккуратно 😄
  </p>

  <div class="box">
    <b>ПРОТОКОЛ 23-ФЕВ</b><br/><br/>

    Операция:
    <b>
      <%= (d.gift && d.gift.trim()) ? d.gift : "Секретная миссия 2.0" %>
    </b><br/>

    Цель: улыбка бойца + 1 обнимашка<br/>
    Условие: нажать <b>«ТАК ТОЧНО!»</b>
  </div>

  <div class="actions">
    <button id="btnYes" class="btn yes">ТАК ТОЧНО!</button>
    <button id="btnNo" class="btn no">НИКАК НЕТ</button>
  </div>

  <div class="log" id="log"></div>

</section>


    <!-- ===== SCREEN 2 ===== -->
    <section id="screenMsg" class="hidden">

      <h1>ПОЗДРАВЛЕНИЕ ПРИНЯТО. ШТАБ ОДОБРЯЕТ ✅</h1>

      <p class="sub">
        Боец <b><%= d.to || "" %></b>, поздравляю с 23 февраля!<br>
        Ниже — секретное сообщение 😎
      </p>

      <div class="box">
        <%- (d.text || "").replace(/\n/g,"<br>") %><br><br>
        <b>— <%= d.from || "Штаб" %></b>
      </div>

    </section>

  </div>
</div>

<script>
const btnYes = document.getElementById("btnYes");
const btnNo = document.getElementById("btnNo");
const intro = document.getElementById("screenIntro");
const msg = document.getElementById("screenMsg");
const chip = document.getElementById("chipScreen");
const log = document.getElementById("log");

let tries = 0;

// Убегающая кнопка НЕТ
btnNo.addEventListener("mouseover", ()=>{
  tries++;
  btnNo.style.position="relative";
  btnNo.style.left=(Math.random()*200-100)+"px";
  btnNo.style.top=(Math.random()*80-40)+"px";
  log.innerHTML += "[ШТАБ] Отказ не принят. Попробуйте ещё раз<br>";
});

// Нажали ДА
btnYes.onclick = ()=>{
  intro.classList.add("hidden");
  msg.classList.remove("hidden");
  chip.innerText="ЭКРАН: ПОЗДРАВЛЕНИЕ";
};
<script>

const log = document.getElementById("log");
const btnYes = document.getElementById("btnYes");
const btnNo = document.getElementById("btnNo");

function addLog(text, color="#9effc7"){
  const time = new Date().toLocaleTimeString().slice(0,5);
  const line = document.createElement("div");
  line.innerHTML = `[${time}] ${text}`;
  line.style.color = color;
  log.appendChild(line);
  log.scrollTop = log.scrollHeight;
}

setTimeout(()=>addLog("Штаб: отказ не принят. Рекомендуем «ТАК ТОЧНО!»"),400);

btnYes.onclick = ()=>{
  addLog("Принято ✅ Протокол 23-ФЕВ выполнен.","#00ff9c");
  setTimeout(()=>addLog("Открываю доступ к поздравлению..."),900);
  setTimeout(()=>{
    document.getElementById("screenIntro").classList.add("hidden");
    document.getElementById("screenMsg").classList.remove("hidden");
  },1700);
};

btnNo.onmouseenter = ()=>{
  btnNo.style.position="relative";
  btnNo.style.left=(Math.random()*120-60)+"px";
  addLog("Ошибка доступа! 🚫 «НИКАК НЕТ» временно заблокирована.","#ff5a5a");
};

</script>

</body>
</html>

